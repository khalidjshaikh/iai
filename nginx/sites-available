# HTTP
# Serves the static site and allows Let's Encrypt HTTP-01 challenges
# (port 80 must reach the webroot for certificate renewal).
server {
	listen 80 default_server;
	listen [::]:80 default_server;
	server_name _;

	root /var/www/html;
	index index.html index.htm;

	location / {
		try_files $uri $uri/ =404;
	}
}

# HTTPS
# Let's Encrypt certificate for ruby.run / www.ruby.run
# (self-signed fallback until the first issuance)
server {
	listen 443 ssl default_server;
	listen [::]:443 ssl default_server;

	ssl_certificate /etc/letsencrypt/live/ruby.run/fullchain.pem;
	ssl_certificate_key /etc/letsencrypt/live/ruby.run/privkey.pem;
	ssl_protocols TLSv1.2 TLSv1.3;
	ssl_ciphers HIGH:!aNULL:!MD5;

	root /var/www/html;
	index index.html index.htm index.nginx-debian.html;
	server_name _;

	location / {
		try_files $uri $uri/ =404;
	}
}
