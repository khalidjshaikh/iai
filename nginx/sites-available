server {
	listen 80 default_server;
	listen [::]:80 default_server;

	# HTTP/3 (QUIC) and HTTPS (TLS)
	listen 443 ssl default_server;
	listen [::]:443 ssl default_server;
    ssl_certificate /etc/letsencrypt/live/assembler.bond/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/assembler.bond/privkey.pem; # managed by Certbot
	listen 443 quic reuseport default_server;
	listen [::]:443 quic reuseport default_server;
	ssl_protocols TLSv1.2 TLSv1.3;

	# Advertise HTTP/3 via Alt-Svc header
	add_header Alt-Svc 'h3=":443"; ma=86400';

	root /var/www/html;

	# Add index.php to the list if you are using PHP
	index index.html index.htm index.nginx-debian.html;

	server_name assembler.bond cicd.lol csharp.bond iai.lol golang.bond ipython.site irobotics.space java.cam javascript.mom khalidshaikh.online kubernetes.website linuxkernel.bond neuralnetwork.bond openshift.bond ruby.run rubyinc.org sql.mom typescript.bond;

	location / {
		# First attempt to serve request as file, then
		# as directory, then fall back to displaying a 404.
		try_files $uri $uri/ =404;
	}
}
