server {
	listen 80 default_server;
	listen [::]:80 default_server;

	# HTTP/3 (QUIC) and HTTPS (TLS)
	listen 443 ssl default_server;
	listen [::]:443 ssl default_server;
    ssl_certificate /etc/letsencrypt/live/assembler.bond-0001/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/assembler.bond-0001/privkey.pem; # managed by Certbot
	listen 443 quic reuseport default_server;
	listen [::]:443 quic reuseport default_server;
	ssl_protocols TLSv1.2 TLSv1.3;

	# Advertise HTTP/3 via Alt-Svc header
	add_header Alt-Svc 'h3=":443"; ma=86400';

	root /var/www/html;

	# Add index.php to the list if you are using PHP
	index index.html index.htm index.nginx-debian.html;

	server_name assembler.bond cicd.lol csharp.bond iai.lol golang.bond ipython.site irobotics.space java.cam javascript.mom khalidshaikh.online kubernetes.website linuxkernel.bond neuralnetwork.bond openshift.bond ruby.run rubyinc.org sql.mom typescript.bond;

	location / {
		# First attempt to serve request as file, then
		# as directory, then fall back to displaying a 404.
		try_files $uri $uri/ =404;
	}

	# Proxy the Ollama API (frontend calls https://iai.lol/api/chat).
	# Ollama handles CORS itself (Access-Control-Allow-Origin: *).
	location /api/ {
		proxy_pass http://iai.lol:11434;
		proxy_http_version 1.1;
		proxy_set_header Connection "";
		# Ollama rejects non-local Host headers (DNS-rebinding protection)
		proxy_set_header Host localhost;
		proxy_buffering off;
		proxy_read_timeout 600s;
	}
}
